<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement name="BrainPanel" style="position: absolute; top: 12px; left: 12px; width: 560px; background-color: rgba(0, 0, 0, 0.78); border-left-color: rgba(255, 255, 255, 0.52); border-right-color: rgba(255, 255, 255, 0.52); border-top-color: rgba(255, 255, 255, 0.52); border-bottom-color: rgba(255, 255, 255, 0.52); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; padding-left: 12px; padding-right: 12px; padding-top: 12px; padding-bottom: 12px;">
        <engine:Label text="AI BRAIN HUD" name="BrainTitleLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); font-size: 14px; margin-bottom: 8px;" />
        <engine:Label text="PLAYER CONTROL" name="BrainModeLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(160, 220, 255); font-size: 12px; margin-bottom: 8px;" />
        <engine:Label text="BEST ACTION: waiting" name="BrainSelectedActionLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(184, 255, 183); font-size: 12px; margin-bottom: 10px;" />
        <engine:Label text="Action Ranking" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); font-size: 12px; margin-bottom: 6px;" />
        <engine:VisualElement name="BrainRankingList" style="margin-bottom: 10px;" />
        <engine:Label text="Imagined Futures" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); font-size: 12px; margin-bottom: 6px;" />
        <engine:VisualElement name="BrainFuturesList" style="margin-bottom: 10px;" />
        <engine:Label text="metrics: waiting for model" name="BrainMetricsLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 230, 150); font-size: 10px; white-space: normal; margin-bottom: 10px;" />
        <engine:Label text="Toggle AI to inspect reasoning." name="BrainExplanationLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); font-size: 11px; white-space: normal;" />
        <engine:VisualElement name="CoachOverlay" style="display: none; margin-top: 10px; padding-top: 10px; border-top-color: rgba(255, 255, 255, 0.16); border-top-width: 1px;">
            <engine:Label text="AI COACH" name="CoachModeBadge" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 212, 102); font-size: 10px; margin-bottom: 8px;" />
            <engine:Label text="M: HUMAN → COACH → AI" name="CoachInstructionLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(210, 210, 210); font-size: 9px; white-space: normal; margin-bottom: 8px;" />
            <engine:Label text="AI suggests: waiting" name="CoachSuggestionLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(140, 255, 115); font-size: 13px; white-space: normal; margin-bottom: 6px;" />
            <engine:Label text="Following AI: 0/0 (0%)" name="CoachComplianceLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(160, 220, 255); font-size: 10px; white-space: normal; margin-bottom: 6px;" />
            <engine:Label text="Risk: waiting for suggestion." name="CoachRiskLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 190, 190); font-size: 10px; white-space: normal;" />
        </engine:VisualElement>
    </engine:VisualElement>
    <engine:VisualElement name="ModelControlPanel" style="position: absolute; top: 10px; right: 10px; flex-direction: row; align-items: center; gap: 8px;">
        <engine:Label text="PLAYER" name="ModelStatusLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); font-size: 8px; -unity-text-align: middle-right;" />
        <engine:Button text="AI OFF" name="ModelToggleButton" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0.72); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; font-size: 8px; padding-left: 8px; padding-right: 8px; padding-top: 5px; padding-bottom: 5px; min-width: 72px;" />
    </engine:VisualElement>
    <engine:Label text="Food : 100" name="FoodLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); font-size: 10px; -unity-text-align: upper-center; position: absolute; bottom: 0; left: 0; right: 0;" />
    <engine:Label text="- LEVEL 1 -" name="LevelLabel" style="font-size: 10px; -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); -unity-text-align: upper-center; position: absolute; bottom: 25px; right: 0; left: 0;" />
    <engine:VisualElement name="GameOverPanel" style="flex-grow: 1; position: absolute; right: 0; top: 0; bottom: 0; left: 0; background-color: rgba(0, 0, 0, 0.78); align-items: center; justify-content: space-around;">
        <engine:Label text="GAME OVER" name="GameOverMessage" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); align-items: center; justify-content: space-around; color: rgb(255, 255, 255); -unity-text-align: middle-center;" />
        <engine:VisualElement name="DemoSummaryPanel" style="background-color: rgba(0, 0, 0, 0.58); border-left-color: rgba(255, 255, 255, 0.35); border-right-color: rgba(255, 255, 255, 0.35); border-top-color: rgba(255, 255, 255, 0.35); border-bottom-color: rgba(255, 255, 255, 0.35); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; padding-left: 12px; padding-right: 12px; padding-top: 10px; padding-bottom: 10px; max-width: 560px;">
            <engine:Label text="Demo summary unavailable." name="DemoSummaryLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); font-size: 9px; white-space: normal; -unity-text-align: middle-left;" />
        </engine:VisualElement>
        <engine:Button text="NEW RUN" name="RestartButton" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0.72); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; font-size: 8px; padding-left: 12px; padding-right: 12px; padding-top: 7px; padding-bottom: 7px;" />
    </engine:VisualElement>
</engine:UXML>
